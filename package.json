{
  "name": "live-voice-offline-map",
  "version": "1.0.0",
  "description": "Offline map of Tashkent with GPS tracking module for Live Voice",
  "main": "index.js",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint ."
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.73.4",
    "react-native-maps": "^1.10.0",
    "@react-native-community/geolocation": "^3.2.1",
    "react-native-fs": "^2.20.0",
    "react-native-sqlite-storage": "^6.0.1",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "react-native-screens": "^3.29.0",
    "react-native-safe-area-context": "^4.8.2",
    "react-native-vector-icons": "^10.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/babel-preset": "0.73.21",
    "@react-native/eslint-config": "0.73.2",
    "@react-native/metro-config": "0.73.3",
    "@react-native/typescript-config": "0.73.1",
    "@types/react": "^18.2.6",
    "@types/react-native": "^0.73.0",
    "@types/react-native-sqlite-storage": "^6.0.5",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "typescript": "5.0.4"
  },
  "jest": {
    "preset": "react-native",
    "moduleNameMapper": {
      "react-native-maps": "<rootDir>/src/__mocks__/react-native-maps.js",
      "@react-native-community/geolocation": "<rootDir>/src/__mocks__/geolocation.js",
      "react-native-fs": "<rootDir>/src/__mocks__/react-native-fs.js",
      "react-native-sqlite-storage": "<rootDir>/src/__mocks__/react-native-sqlite-storage.js"
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": "@react-native"
  },
  "prettier": {
    "arrowParens": "avoid",
    "bracketSameLine": true,
    "bracketSpacing": false,
    "singleQuote": true,
    "trailingComma": "all"
  }
}
