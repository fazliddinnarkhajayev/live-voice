{
  "name": "live-voice",
  "version": "1.0.0",
  "description": "Live Voice – voice recording and playback app",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint ."
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.73.4",
    "@react-native-community/voice": "^1.1.9",
    "react-native-sound": "^0.11.2",
    "react-native-fs": "^2.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/babel-preset": "0.73.21",
    "@react-native/eslint-config": "0.73.2",
    "@react-native/metro-config": "0.73.3",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "react-test-renderer": "18.2.0"
  },
  "jest": {
    "preset": "react-native",
    "moduleNameMapper": {
      "@react-native-community/voice": "<rootDir>/src/__mocks__/voice.js",
      "react-native-sound": "<rootDir>/src/__mocks__/sound.js",
      "react-native-fs": "<rootDir>/src/__mocks__/react-native-fs.js"
    },
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  }
}
