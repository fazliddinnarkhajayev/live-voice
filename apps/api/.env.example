# Application
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=livevoice
# Or use DATABASE_URL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/livevoice

# JWT
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# CORS - restrict to your mobile app's domain in production
# CORS_ORIGIN=https://your-app.example.com

# LiveKit
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
