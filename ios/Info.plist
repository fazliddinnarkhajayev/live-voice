<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDisplayName</key>
  <string>Live Voice Map</string>
  <key>CFBundleIdentifier</key>
  <string>com.livevoice.offlinemap</string>
  <key>CFBundleName</key>
  <string>live-voice-offline-map</string>
  <key>CFBundleShortVersionString</key>
  <string>1.0</string>
  <key>CFBundleVersion</key>
  <string>1</string>

  <!-- Location permission descriptions (required by App Store) -->
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>Live Voice needs your location to show your position on the offline Tashkent map and to record your GPS track.</string>

  <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
  <string>Live Voice uses your location in the background to continue recording your GPS track while the app is not in the foreground.</string>

  <key>NSLocationAlwaysUsageDescription</key>
  <string>Live Voice uses your location in the background to continue recording your GPS track while the app is not in the foreground.</string>

  <!-- ATS – allow local file:// tile serving -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key>
    <false/>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
</dict>
</plist>
